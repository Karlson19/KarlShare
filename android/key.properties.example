# Karlshare release signing — TEMPLATE
#
# 1. Generate an upload keystore (do this once, keep the .jks safe & backed up):
#
#    keytool -genkey -v -keystore karlshare-upload.jks \
#      -keyalg RSA -keysize 2048 -validity 10000 -alias karlshare
#
# 2. Copy this file to `android/key.properties` (already gitignored) and fill in
#    the real values. NEVER commit key.properties or the .jks.
#
# 3. `flutter build apk --release --split-per-abi` will now sign with your key.
#    Without key.properties present, release builds fall back to debug signing.

storePassword=CHANGE_ME
keyPassword=CHANGE_ME
keyAlias=karlshare
# Absolute path, or relative to the android/app directory:
storeFile=/absolute/path/to/karlshare-upload.jks
